<!DOCTYPE html>
<!-- Crave Productions Pvt Ltd — WhatsApp Connect Page -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>Crave Productions — Connect</title>
    <link rel="icon" href="https://i.ibb.co/ns12Jcm0/file-00000000783c8211805f5a335e05e874.png">
    <link rel="preload" as="image" href="https://i.ibb.co/ns12Jcm0/file-00000000783c8211805f5a335e05e874.png">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fff6ee;
            color: #4a2410;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* ---- Ambient backdrop: bakery photo, softened so panel text stays readable ---- */
        .backdrop {
            position: fixed; inset: 0; z-index: 0;
            background: linear-gradient(180deg, rgba(255,249,242,0.88) 0%, rgba(255,241,224,0.93) 100%), url('/bakery-bg.jpg');
            background-size: cover; background-position: center; background-attachment: fixed;
        }
        .glow { position: fixed; border-radius: 50%; filter: blur(80px); z-index: 0; opacity: 0.35; pointer-events: none; }
        .glow-a { width: 360px; height: 360px; top: -140px; left: -110px; background: radial-gradient(circle, #ff7a1a, transparent 70%); animation: drift1 16s ease-in-out infinite; }
        .glow-b { width: 320px; height: 320px; bottom: -110px; right: -90px; background: radial-gradient(circle, #C11718, transparent 70%); animation: drift2 20s ease-in-out infinite; }
        @keyframes drift1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(40px, 60px); } }
        @keyframes drift2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-30px, -50px); } }

        .stage { position: relative; z-index: 2; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 30px 18px 26px; }

        /* ---- Front art: small ASCII-style flourish above the logo ---- */
        .front-art { font-family: 'Courier New', monospace; font-size: 9px; line-height: 1.1; color: #ff7a1a; white-space: pre; text-align: center; opacity: 0.75; margin-bottom: 6px; animation: riseIn 0.9s ease-out both; }

        /* ---- Logo shown as-is on a white card, no dark filter needed ---- */
        .logo-shot { width: 100%; max-width: 300px; margin: 0 auto; animation: riseIn 0.9s ease-out both; background: #fff; border-radius: 22px; padding: 16px; box-shadow: 0 14px 34px rgba(193,23,24,0.18); }
        .logo-shot img { width: 100%; display: block; border-radius: 12px; }
        @keyframes riseIn { from { opacity: 0; transform: translateY(-16px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

        /* ---- Sinhala welcome banner ---- */
        .welcome-banner { text-align: center; margin: 16px 0 6px; animation: riseIn 0.9s ease-out 0.05s both; }
        .welcome-banner .line1 { font-size: 17px; font-weight: 800; color: #C11718; }
        .welcome-banner .line2 { font-size: 12.5px; color: #7a4a20; margin-top: 4px; line-height: 1.5; }

        /* ---- Scrolling text ticker ---- */
        .ticker-wrap { width: 100%; max-width: 420px; overflow: hidden; margin: 14px 0 22px; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
        .ticker { display: flex; white-space: nowrap; animation: scrollTicker 14s linear infinite; }
        .ticker span { font-size: 11px; letter-spacing: 3px; font-weight: 700; color: #C11718; text-transform: uppercase; padding: 0 14px; }
        @keyframes scrollTicker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

        /* ---- Glass pairing panel ---- */
        .panel {
            width: 100%; max-width: 380px;
            background: #ffffff;
            border: 1px solid rgba(193,23,24,0.12);
            border-radius: 24px;
            padding: 28px 24px 24px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(193,23,24,0.1);
            animation: riseIn 0.9s ease-out 0.1s both;
        }
        .panel-title {
            font-size: 13px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 18px; font-weight: 700;
            background: linear-gradient(90deg, #C11718, #ff7a1a, #C11718);
            background-size: 200% auto;
            -webkit-background-clip: text; background-clip: text; color: transparent;
            animation: shimmerTitle 3s linear infinite;
        }
        @keyframes shimmerTitle { to { background-position: -200% center; } }
        .steps { display: flex; flex-direction: column; gap: 8px; margin-top: 20px; text-align: left; }
        .step { display: flex; gap: 10px; align-items: flex-start; font-size: 11.5px; color: #7a4a20; line-height: 1.4; }
        .step b { flex-shrink: 0; color: #ff7a1a; font-size: 12px; }

        /* ---- QR frame with an animated glow border — the border rotates on
           a pseudo-element BEHIND the QR, the QR image itself never moves,
           so it stays scannable at all times. ---- */
        .qr-frame {
            position: relative; width: 100%; max-width: 230px; aspect-ratio: 1/1; margin: 0 auto;
            border-radius: 18px; padding: 3px;
        }
        .qr-frame::before {
            content: ''; position: absolute; inset: 0; border-radius: 18px; z-index: 0;
            background: conic-gradient(from 0deg, #ff7a1a, transparent 30%, transparent 70%, #ff7a1a);
            animation: sweep 3.4s linear infinite;
        }
        @keyframes sweep { to { transform: rotate(360deg); } }
        .qr-inner {
            position: relative; z-index: 1;
            width: 100%; height: 100%; border-radius: 15px; background: #fff8ee;
            display: flex; align-items: center; justify-content: center; overflow: hidden;
        }
        #qrImg { width: 100%; height: 100%; object-fit: contain; display: none; }
        #qrLoading { color: #C11718; font-size: 12.5px; font-weight: 700; letter-spacing: 0.5px; }

        .instruction { font-size: 12.5px; color: #7a4a20; margin-top: 16px; line-height: 1.5; }
        .hint { display: block; font-size: 11px; color: #a97748; margin-top: 8px; }

        .status-row { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 20px; font-size: 12px; color: #7a4a20; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #d8b89a; transition: 0.3s; }
        .status-dot.online { background: #2e9e4f; box-shadow: 0 0 10px #2e9e4f; animation: pulseDot 1.6s ease-in-out infinite; }
        .status-dot.offline { background: #b23a3a; box-shadow: 0 0 8px #b23a3a; }
        @keyframes pulseDot { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.5); opacity: 0.6; } }

        /* ---- Company info card ---- */
        .info-card { width: 100%; max-width: 380px; background: #ffffff; border: 1px solid rgba(193,23,24,0.12); border-radius: 20px; padding: 18px 20px; margin-top: 18px; box-shadow: 0 16px 40px rgba(193,23,24,0.08); animation: riseIn 0.9s ease-out 0.15s both; }
        .info-row { display: flex; gap: 12px; align-items: flex-start; padding: 8px 0; font-size: 12.5px; color: #4a2410; line-height: 1.4; }
        .info-row:not(:last-child) { border-bottom: 1px dashed rgba(193,23,24,0.12); }
        .info-row .ic { font-size: 16px; flex-shrink: 0; }
        .info-row b { display: block; color: #C11718; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }

        /* ---- Stats ---- */
        .stats { display: flex; gap: 0; width: 100%; max-width: 380px; margin-top: 18px; }
        .stat { flex: 1; text-align: center; padding: 10px 4px; }
        .stat:not(:last-child) { border-right: 1px solid rgba(193,23,24,0.14); }
        .stat b { display: block; font-size: 19px; font-weight: 800; background: linear-gradient(90deg,#C11718,#ff7a1a); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .stat span { display: block; font-size: 9.5px; letter-spacing: 1px; text-transform: uppercase; color: #a97748; margin-top: 2px; }

        .foot { margin-top: 24px; font-size: 10.5px; letter-spacing: 1.5px; text-transform: uppercase; color: #a97748; text-align: center; }
        .foot b { color: #C11718; }

        /* ---- Access gate: shown before the QR/pairing UI, private-bot lock ---- */
        .gate-card {
            width: 100%; max-width: 340px; background: #fff; border: 1px solid rgba(193,23,24,0.12);
            border-radius: 24px; padding: 34px 26px 28px; text-align: center; box-shadow: 0 24px 60px rgba(193,23,24,0.14);
            animation: riseIn 0.9s ease-out both;
        }
        .gate-icon {
            width: 52px; height: 52px; margin: 0 auto 16px; border-radius: 16px;
            background: linear-gradient(135deg, #ff7a1a, #C11718);
            display: flex; align-items: center; justify-content: center; font-size: 24px;
            box-shadow: 0 10px 24px rgba(193,23,24,0.3);
        }
        .gate-card .gate-title { font-size: 15px; font-weight: 800; color: #2a1408; margin-bottom: 6px; letter-spacing: 0.3px; }
        .gate-card .gate-sub { font-size: 11.5px; color: #a97748; margin-bottom: 22px; letter-spacing: 0.2px; }
        .gate-card label { display: block; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #C11718; margin-bottom: 8px; text-align: left; }
        .gate-card input {
            width: 100%; padding: 14px 16px; border-radius: 12px; border: 1.5px solid rgba(193,23,24,0.18);
            background: #fff8ee; color: #2a1408; font-size: 15px; outline: none; text-align: center; letter-spacing: 2px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .gate-card input:focus { border-color: #ff7a1a; box-shadow: 0 0 0 3px rgba(255,122,26,0.12); }
        .gate-card button {
            width: 100%; margin-top: 14px; background: linear-gradient(135deg, #ff7a1a, #C11718); color: #fff;
            border: none; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 14px; letter-spacing: 0.3px; cursor: pointer;
            box-shadow: 0 10px 24px rgba(193,23,24,0.25); transition: transform 0.15s, box-shadow 0.15s;
        }
        .gate-card button:active { transform: scale(0.98); }
        .gate-err { color: #C11718; font-size: 11.5px; margin-top: 12px; min-height: 14px; font-weight: 600; }
        .hidden { display: none !important; }

        /* ---- Drifting embers ---- */
        .ember { position: fixed; bottom: -4vh; border-radius: 50%; background: #ff7a1a; pointer-events: none; z-index: 1; animation: emberRise linear infinite; box-shadow: 0 0 6px #ff7a1a; opacity: 0.5; }
        @keyframes emberRise {
            0% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 0.5; }
            90% { opacity: 0.3; }
            100% { transform: translateY(-108vh) translateX(24px); opacity: 0; }
        }

        @media (min-width: 480px) {
            .stage { padding-top: 48px; }
        }
    </style>
</head>
<body>
    <div class="backdrop"></div>
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
    <div id="embers"></div>

    <div class="stage">
        <div class="logo-shot">
            <img src="https://i.ibb.co/ns12Jcm0/file-00000000783c8211805f5a335e05e874.png" alt="Crave Productions">
        </div>

        <div class="ticker-wrap">
            <div class="ticker">
                <span>PREMIUM BAKERY</span><span>·</span><span>CUSTOM CAKES</span><span>·</span><span>FRESHLY BAKED</span><span>·</span><span>SATISFY YOUR CRAVINGS</span><span>·</span>
                <span>PREMIUM BAKERY</span><span>·</span><span>CUSTOM CAKES</span><span>·</span><span>FRESHLY BAKED</span><span>·</span><span>SATISFY YOUR CRAVINGS</span><span>·</span>
            </div>
        </div>

        <div class="gate-card" id="gateCard">
            <div class="gate-icon">🔒</div>
            <div class="gate-title">Staff Access Only</div>
            <div class="gate-sub">This is a private business system</div>
            <label for="gateCode">Access Code</label>
            <input type="password" id="gateCode" placeholder="Enter code" autocomplete="off">
            <button onclick="unlockGate()">Unlock</button>
            <div class="gate-err" id="gateErr"></div>
        </div>

        <div id="mainContent" class="hidden">
        <div class="panel">
            <div class="panel-title">Scan to connect</div>
            <div class="qr-frame">
                <div class="qr-inner">
                    <img id="qrImg" src="" alt="QR code">
                    <div id="qrLoading">Preparing your code…</div>
                </div>
            </div>
            <div class="steps">
                <div class="step"><b>1.</b> Open WhatsApp on your phone</div>
                <div class="step"><b>2.</b> Go to Settings → Linked Devices</div>
                <div class="step"><b>3.</b> Tap "Link a Device" and scan the code above</div>
            </div>
            <span class="hint" id="qrHint">Refreshes automatically</span>

            <div class="status-row">
                <span class="status-dot" id="statusDot"></span>
                <span id="statusText">Checking status…</span>
            </div>
        </div>

        <div class="info-card">
            <div class="info-row"><span class="ic">🏢</span><div><b>Company</b>Crave Productions Pvt Ltd</div></div>
            <div class="info-row"><span class="ic">📍</span><div><b>Location</b>107, Pallethalawinna, Katugastota, Sri Lanka</div></div>
            <div class="info-row"><span class="ic">☎️</span><div><b>Hotline</b>+94 70 288 8052</div></div>
            <div class="info-row"><span class="ic">✉️</span><div><b>Email</b>craveproductions917@gmail.com</div></div>
        </div>

        <div class="stats">
            <div class="stat"><b>🎂</b><span>Fresh Baked</span></div>
            <div class="stat"><b id="statBots">0</b><span>Online</span></div>
            <div class="stat"><b>24/7</b><span>Available</span></div>
        </div>

        <div class="foot">🎂 <b>Crave Productions Pvt Ltd</b> — Satisfy Your Cravings 🎂</div>
        </div>
    </div>

    <script>
        // ---- Sound design: original short arpeggio motifs (no external files) ----
        let audioCtx = null;
        function getCtx() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            return audioCtx;
        }
        function tone(freq, duration, delay, type, gainPeak) {
            try {
                const ctx = getCtx();
                if (ctx.state === 'suspended') ctx.resume();
                setTimeout(() => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = type || 'sine';
                    osc.frequency.value = freq;
                    gain.gain.setValueAtTime(gainPeak || 0.07, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration / 1000);
                    osc.connect(gain).connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + duration / 1000);
                }, delay || 0);
            } catch (e) {}
        }
        function playWelcome() {
            tone(440, 120, 0, 'triangle', 0.05);
            tone(659, 140, 110, 'triangle', 0.05);
            tone(880, 200, 240, 'triangle', 0.06);
        }
        function playQrReady() { tone(587, 90, 0, 'sine', 0.05); }
        function playConnected() {
            tone(523, 110, 0, 'triangle', 0.07);
            tone(659, 110, 100, 'triangle', 0.07);
            tone(784, 140, 200, 'triangle', 0.08);
            tone(1046, 240, 340, 'triangle', 0.08);
        }
        let audioUnlocked = false;
        function unlockAudioOnce() {
            if (audioUnlocked) return;
            audioUnlocked = true;
            try { const ctx = getCtx(); if (ctx.state === 'suspended') ctx.resume(); } catch (e) {}
            playWelcome();
            ['click', 'touchstart', 'keydown'].forEach(evt => document.removeEventListener(evt, unlockAudioOnce));
        }
        ['click', 'touchstart', 'keydown'].forEach(evt => document.addEventListener(evt, unlockAudioOnce));

        // ---- Session bootstrap (per-browser bot session) ----
        // Private bot: a brand-new session needs the access code (gate).
        // A session already paired on this device/browser just resumes.
        let sessionId = null;
        async function tryResumeSession() {
            const stored = localStorage.getItem('crave_session_id');
            if (!stored) return false;
            try {
                const res = await fetch('/health?session=' + encodeURIComponent(stored));
                const data = await res.json();
                if (data.exists) { sessionId = stored; return true; }
            } catch (e) {}
            return false;
        }
        async function createSessionWithCode(code) {
            const res = await fetch('/api/new-session', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code })
            });
            if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error(err.error || 'Failed'); }
            const data = await res.json();
            sessionId = data.sessionId;
            localStorage.setItem('crave_session_id', sessionId);
            localStorage.setItem('crave_pair_code', code);
            return sessionId;
        }
        function showMain() {
            document.getElementById('gateCard').classList.add('hidden');
            document.getElementById('mainContent').classList.remove('hidden');
        }
        async function unlockGate() {
            const code = document.getElementById('gateCode').value.trim();
            const errEl = document.getElementById('gateErr');
            errEl.innerText = '';
            if (!code) { errEl.innerText = 'Please enter the access code.'; return; }
            try {
                await createSessionWithCode(code);
                showMain();
                startQrPolling();
                refreshStats();
                setInterval(refreshStats, 5000);
            } catch (e) {
                errEl.innerText = '❌ Wrong access code. Try again.';
            }
        }
        document.getElementById('gateCode').addEventListener('keydown', (e) => { if (e.key === 'Enter') unlockGate(); });

        // ---- Status polling ----
        let hasPlayedConnectChime = false;
        let statusInterval = null;
        async function checkStatus() {
            try {
                const res = await fetch('/health?session=' + encodeURIComponent(sessionId));
                const data = await res.json();
                const dot = document.getElementById('statusDot');
                const text = document.getElementById('statusText');
                if (data.connected) {
                    dot.className = 'status-dot online';
                    text.innerText = 'Bot connected';
                    if (!hasPlayedConnectChime) { hasPlayedConnectChime = true; playConnected(); }
                    if (statusInterval) { clearInterval(statusInterval); statusInterval = setInterval(checkStatus, 8000); }
                } else {
                    dot.className = 'status-dot offline';
                    text.innerText = 'Waiting for connection…';
                }
            } catch (e) {
                document.getElementById('statusText').innerText = 'Status unavailable';
            }
        }
        function pollStatus(fast) {
            checkStatus();
            if (statusInterval) clearInterval(statusInterval);
            statusInterval = setInterval(checkStatus, fast ? 3000 : 8000);
        }

        // ---- Stats polling ----
        async function refreshStats() {
            try {
                const res = await fetch('/api/stats');
                const data = await res.json();
                const el = document.getElementById('statBots');
                if (el) el.innerText = data.active;
            } catch (e) {}
        }

        // ---- QR polling ----
        let qrInterval = null;
        let hasPlayedQrChime = false;
        function refreshQR() {
            const img = document.getElementById('qrImg');
            const loading = document.getElementById('qrLoading');
            const hint = document.getElementById('qrHint');
            const testImg = new Image();
            testImg.onload = () => {
                img.src = testImg.src;
                img.style.display = 'block';
                loading.style.display = 'none';
                hint.innerText = 'Refreshes automatically';
                if (!hasPlayedQrChime) { hasPlayedQrChime = true; playQrReady(); }
            };
            testImg.onerror = async () => {
                try {
                    const res = await fetch('/qr?session=' + encodeURIComponent(sessionId));
                    const data = await res.json().catch(() => null);
                    if (data?.error === 'Bot is already connected!') {
                        hint.innerText = 'Already connected';
                        if (qrInterval) { clearInterval(qrInterval); qrInterval = null; }
                        return;
                    }
                } catch (e) {}
                loading.innerText = 'Waiting for code…';
            };
            testImg.src = '/qr?session=' + encodeURIComponent(sessionId) + '&t=' + Date.now();
        }
        function startQrPolling() {
            refreshQR();
            if (qrInterval) clearInterval(qrInterval);
            qrInterval = setInterval(refreshQR, 5000);
            pollStatus(true);
        }

        (async function init() {
            const resumed = await tryResumeSession();
            if (resumed) {
                showMain();
                startQrPolling();
                refreshStats();
                setInterval(refreshStats, 5000);
            }
            // else: leave the gate showing, waiting for unlockGate()
        })();

        // ---- Drifting embers (plain CSS dots — no icon assets) ----
        function spawnEmbers() {
            const wrap = document.getElementById('embers');
            const count = window.innerWidth < 500 ? 12 : 20;
            for (let i = 0; i < count; i++) {
                const e = document.createElement('span');
                e.className = 'ember';
                const size = 2 + Math.random() * 3;
                e.style.width = size + 'px';
                e.style.height = size + 'px';
                e.style.left = Math.random() * 100 + 'vw';
                const duration = 9 + Math.random() * 10;
                e.style.animationDuration = duration + 's';
                e.style.animationDelay = (-Math.random() * duration) + 's';
                wrap.appendChild(e);
            }
        }
        spawnEmbers();
    </script>
</body>
</html>
